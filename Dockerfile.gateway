FROM node:18-alpine AS base
RUN apk add --no-cache openssl libc6-compat && ln -sf /usr/lib/libssl.so.3 /usr/lib/libssl.so.1.1 && ln -sf /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so.1.1
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/database ./packages/database
COPY packages/ui-components ./packages/ui-components
COPY packages/auth-client ./packages/auth-client
COPY apps ./apps
COPY scripts ./scripts
RUN pnpm install --prefer-offline --frozen-lockfile=false

FROM dependencies AS build
WORKDIR /workspace
RUN pnpm --filter @startupjigawa/database generate || true
RUN pnpm --dir packages/auth-client build
RUN pnpm -r --if-present run build || npm run build || true

FROM base AS runtime
WORKDIR /workspace
ENV NODE_ENV=production
COPY --from=dependencies /workspace/package.json ./package.json
COPY --from=dependencies /workspace/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /workspace/packages /workspace/packages
COPY --from=build /workspace/apps /workspace/apps
COPY --from=build /workspace/scripts /workspace/scripts
COPY --from=dependencies /workspace/node_modules ./node_modules
EXPOSE 3000
CMD ["node", "scripts/subdomain-server.js"]
