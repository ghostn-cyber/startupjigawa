generator client {
  provider      = "prisma-client-js"
  output        = "../client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  OIDC
  SAML
}

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  phoneNumber     String?           @unique @map("phone_number")
  passwordHash    String            @map("password_hash")
  firstName       String?           @map("first_name")
  lastName        String?           @map("last_name")
  isEmailVerified Boolean           @default(false) @map("is_email_verified")
  isPhoneVerified Boolean           @default(false) @map("is_phone_verified")
  isActive        Boolean           @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  roles           UserRole[]
  sessions        Session[]
  identityProviders IdentityProvider[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  uploadedDocuments InstitutionalDocument[] @relation("DocUploader")
  enrollments     Enrollment[]

  @@map("users")
}

model Role {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id")
  tenantId   String?  @map("tenant_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, roleId, tenantId])
  @@map("user_roles")
}

model IdentityProvider {
  id              String        @id @default(uuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String        @map("user_id")
  provider        AuthProvider
  providerKey     String        @map("provider_key")
  subject         String
  issuer          String?
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([provider, subject])
  @@map("identity_providers")
}

model Session {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String    @map("user_id")
  refreshTokenHash String?  @map("refresh_token_hash")
  deviceInfo      String?   @map("device_info")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  meta            Json?

  @@map("sessions")
}

model AuditLog {
  id        String    @id @default(uuid())
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?   @map("actor_id")
  action    String
  resource  String?
  ipAddress String?   @map("ip_address")
  details   Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

model StateMDA {
  id           String                  @id @default(uuid())
  code         String                  @unique
  name         String
  sector       String
  contactEmail String?                 @map("contact_email")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  documents    InstitutionalDocument[]

  @@map("state_mdas")
}

model InstitutionalDocument {
  id             String              @id @default(uuid())
  title          String
  description    String?
  documentType   String              @map("document_type")
  classification String              @default("RESTRICTED")
  fileUrl        String              @map("file_url")
  fileSize       Int                 @default(0) @map("file_size")
  mimeType       String              @default("application/pdf") @map("mime_type")
  mda            StateMDA?           @relation(fields: [mdaId], references: [id], onDelete: SetNull)
  mdaId          String?             @map("mda_id")
  uploadedBy     User?               @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById   String?             @map("uploaded_by_id")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  accessLogs     DocumentAccessLog[]

  @@map("institutional_documents")
}

model DocumentAccessLog {
  id         String                @id @default(uuid())
  document   InstitutionalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String                @map("document_id")
  actorId    String?               @map("actor_id")
  actorRole  String?               @map("actor_role")
  action     String
  requestId  String?               @map("request_id")
  ipAddress  String?               @map("ip_address")
  userAgent  String?               @map("user_agent")
  createdAt  DateTime              @default(now()) @map("created_at")

  @@map("document_access_logs")
}

model Course {
  id             String       @id @default(uuid())
  code           String       @unique
  title          String
  description    String?
  track          String       @default("Software Engineering")
  level          String       @default("Intermediate")
  durationWeeks  Int          @default(12) @map("duration_weeks")
  instructorName String?      @map("instructor_name")
  isPublished    Boolean      @default(true) @map("is_published")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  modules        Module[]
  enrollments    Enrollment[]

  @@map("courses")
}

model Cohort {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  startDate   DateTime?    @map("start_date")
  endDate     DateTime?    @map("end_date")
  maxStudents Int          @default(100) @map("max_students")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  enrollments Enrollment[]

  @@map("cohorts")
}

model Module {
  id          String       @id @default(uuid())
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String       @map("course_id")
  title       String
  content     String?
  videoUrl    String?      @map("video_url")
  orderIndex  Int          @default(1) @map("order_index")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  submissions Submission[]

  @@map("course_modules")
}

model Enrollment {
  id              String       @id @default(uuid())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String       @map("user_id")
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String       @map("course_id")
  cohort          Cohort?      @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  cohortId        String?      @map("cohort_id")
  status          String       @default("active")
  progressPercent Int          @default(0) @map("progress_percent")
  enrolledAt      DateTime     @default(now()) @map("enrolled_at")
  completedAt     DateTime?    @map("completed_at")
  submissions     Submission[]

  @@unique([userId, courseId, cohortId])
  @@map("enrollments")
}

model Submission {
  id            String     @id @default(uuid())
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId  String     @map("enrollment_id")
  module        Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId      String     @map("module_id")
  submissionUrl String?    @map("submission_url")
  notes         String?
  grade         String?
  reviewedAt    DateTime?  @map("reviewed_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("module_submissions")
}

model Project {
  id              String          @id @default(uuid())
  code            String          @unique
  slug            String?         @unique
  title           String
  description     String?
  category        String          @default("AgriTech")
  sector          String?         @default("AgriTech")
  visibility      String          @default("PUBLIC")
  lga             String          @default("Dutse")
  leadAgency      String          @default("Startup Jigawa Ltd") @map("lead_agency")
  budget          Float           @default(0.0)
  status          String          @default("Active")
  ragStatus       String          @default("GREEN") @map("rag_status")
  progressPercent Int             @default(0) @map("progress_percent")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  milestones      Milestone[]
  kpiMetrics      KPIMetric[]
  projectUpdates  ProjectUpdate[]

  @@map("projects")
}

model Milestone {
  id          String    @id @default(uuid())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id")
  title       String
  targetDate  DateTime? @map("target_date")
  status      String    @default("Pending")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("project_milestones")
}

model KPIMetric {
  id           String   @id @default(uuid())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String   @map("project_id")
  name         String
  targetValue  Float    @map("target_value")
  currentValue Float    @map("current_value")
  unit         String   @default("count")
  category     String   @default("General")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("kpi_metrics")
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  authorId  String?  @map("author_id")
  title     String
  content   String
  ragStatus String   @default("GREEN") @map("rag_status")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_updates")
}

model SystemAuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  resource   String
  details    String?
  ipAddress  String?  @map("ip_address")
  subdomain  String   @default("admin")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("system_audit_logs")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  isEnabled   Boolean  @default(false) @map("is_enabled")
  environment String   @default("production")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model GlobalRoleOverride {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  grantedRole String   @map("granted_role")
  assignedBy String    @map("assigned_by")
  reason     String?
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("global_role_overrides")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_sessions")
}

